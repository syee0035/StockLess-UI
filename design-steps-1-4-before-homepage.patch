new file mode 100644
index 0000000..7acc8df
--- /dev/null
+++ b/frontend/src/screens/product-category.ts
@@ -0,0 +1,29 @@
+/** Display-only shelf groups for the Step 3 tabs. Matching is by keywords in the product name. */
+export type ProductCategory = "beverages" | "staples" | "snacks" | "fresh" | "cooking" | "nonfood" | "other";
+
+export const CATEGORY_LABELS: Readonly<Record<ProductCategory, string>> = Object.freeze({
+  beverages: "Beverages",
+  staples: "Staples",
+  snacks: "Snacks",
+  fresh: "Fresh & dairy",
+  cooking: "Cooking & canned",
+  nonfood: "Non-food",
+  other: "Other",
+});
+
+const RULES: readonly (readonly [ProductCategory, readonly string[]])[] = [
+  ["beverages", ["kopi", "coffee", "milo", "nescafe", "air mineral", "mineral water", "teh", "tea", "horlicks", "drink", "minuman"]],
+  ["staples", ["beras", "rice", "tepung", "flour", "gula", "sugar", "garam", "salt", "minyak", "oil"]],
+  ["snacks", ["biskut", "biscuit", "keropok", "kerepek", "coklat", "chocolate", "chips", "snack"]],
+  ["fresh", ["roti", "bread", "telur", "egg", "susu", "milk", "yogurt", "cheese"]],
+  ["cooking", ["sardin", "sardine", "sos", "sauce", "kicap", "soy", "cuka", "vinegar", "kari", "curry", "serbuk", "mi segera", "noodle", "cili", "chilli", "tin"]],
+  ["nonfood", ["sabun", "soap", "ubat gigi", "toothpaste", "berus", "brush", "beg", "bag", "tisu", "tissue", "detergent"]],
+];
+
+export function categoryOf(name: string): ProductCategory {
+  const lower = name.toLowerCase();
+  for (const [category, words] of RULES) {
+    if (words.some((word) => lower.includes(word))) return category;
+  }
+  return "other";
+}
