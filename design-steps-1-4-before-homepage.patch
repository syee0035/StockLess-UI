@@ -0,0 +1,62 @@
+import { useEffect, useRef, useState, type ReactNode } from "react";
+import { t, useLanguage } from "../i18n/index.ts";
+
+const PLANTS = ["🌱", "🌿", "🪴", "🌳"] as const;
+
+/**
+ * Mint title band shared by Steps 1–4. It also holds the step's navigation buttons and
+ * sticks to the top of the window; once the page scrolls it shrinks to one slim row.
+ */
+export function ScreenHero({
+  step,
+  detail,
+  title,
+  lede,
+  aside,
+  actions,
+  titleClassName = "title",
+}: {
+  readonly step: 1 | 2 | 3 | 4;
+  readonly detail?: ReactNode;
+  readonly title: ReactNode;
+  readonly lede?: ReactNode;
+  readonly aside?: ReactNode;
+  readonly actions?: ReactNode;
+  readonly titleClassName?: string;
+}) {
+  useLanguage();
+  const [stuck, setStuck] = useState(false);
+  const stuckRef = useRef(false);
+  useEffect(() => {
+    if (typeof window === "undefined") return;
+    // Hysteresis stops the header flickering while its own height changes.
+    const check = () => {
+      const y = window.scrollY;
+      const next = stuckRef.current ? y > 40 : y > 140;
+      if (next !== stuckRef.current) {
+        stuckRef.current = next;
+        setStuck(next);
+      }
+    };
+    check();
+    window.addEventListener("scroll", check, { passive: true });
+    return () => window.removeEventListener("scroll", check);
+  }, []);
+  return (
+    <section className={`screen-hero${stuck ? " screen-hero--stuck" : ""}${actions ? " screen-hero--actions" : ""}`}>
+      <div className="screen-hero__row">
+        <div className="screen-hero__text">
+          <p className="eyebrow screen-hero__eyebrow">
+            <span aria-hidden="true">{PLANTS[step - 1]}</span>
+            {t(`Step ${step} of 4`)}
+            {detail ? <span className="screen-hero__detail"> · {detail}</span> : null}
+          </p>
+          <h1 className={titleClassName}>{title}</h1>
+          {lede ? <p className="lede">{lede}</p> : null}
+        </div>
+        {aside ? <div className="screen-hero__aside">{aside}</div> : null}
+      </div>
+      {actions ? <div className="screen-hero__actions">{actions}</div> : null}
+    </section>
+  );
+}
