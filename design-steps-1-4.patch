+/* ---------- how it works: the steps light up in turn; hover or focus holds one ---------- */
+function HowItWorks({ c, start }: { readonly c: Copy; readonly start: string }) {
+  const [active, setActive] = useState(0);
+  const held = useRef(false);
+  useEffect(() => {
+    if (reducedMotion()) return;
+    const timer = window.setInterval(() => { if (!held.current) setActive(value => (value + 1) % 4); }, 2400);
+    return () => window.clearInterval(timer);
+  }, []);
+  const hold = (index: number) => { held.current = true; setActive(index); };
+  const release = () => { held.current = false; };
+  return <section className="hp-how" id="how-it-works"><div className="wrap">
+    <p className="hp-k3 hp-center">{c("hp.how.k")}</p>
+    <h2 className="hp-center">{c("hp.how.h1")}<em>{c("hp.how.h2")}</em></h2>
+    <div className="hp-steps__line" aria-hidden="true"><span style={{ width: `${(active + 1) * 25}%` }} /></div>
+    <div className="hp-steps">{["🌱", "🌿", "🪴", "🌳"].map((plant, index) =>
+      <a key={plant} className={`hp-step${index === active ? " is-on" : ""}`} href={start}
+        onMouseEnter={() => hold(index)} onMouseLeave={release} onFocus={() => hold(index)} onBlur={release}>
+        <span className="hp-step__n">{index + 1}</span><span className="hp-step__plant" aria-hidden="true">{plant}</span>
+        <b>{c(`hp.s${index + 1}`)}</b><p>{c(`hp.s${index + 1}t`)}</p>
+      </a>)}</div>
+  </div></section>;
 }
