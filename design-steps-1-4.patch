+.sx-tab{flex:1;min-height:48px;border:0;border-radius:999px;background:transparent;cursor:pointer;
+  font:700 var(--text-body)/1 var(--display);color:var(--ink-2);transition:background-color .25s,color .25s}
+.sx-tab[aria-selected="true"]{background:var(--teal);color:#fff;box-shadow:0 6px 14px rgba(22,125,116,.22)}
+.sx-tab:focus-visible{outline:3px solid var(--teal-deep);outline-offset:2px}
+.sx-panel{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:24px;padding:22px 18px 0}
+.sx-panel[hidden]{display:none}
+.sx-big{margin:0;font-family:var(--display);font-size:52px;line-height:1;font-weight:700;color:var(--teal-deep)}
+.sx-big small{font-size:var(--text-lead);font-weight:700;color:var(--ink-2)}
+.sx-sub{margin:8px 0 0;color:var(--muted)}
+.sx-chips{display:flex;flex-wrap:wrap;gap:8px;list-style:none;margin:12px 0 0;padding:0}
+.sx-chips li{padding:6px 12px;border-radius:999px;background:var(--teal-tint);font-size:var(--text-secondary);color:var(--ink-2)}
+.sx-chips b{color:var(--teal-deep)}.sx-chips .num{font-size:var(--text-label);color:var(--muted)}
+.sx-co2{align-self:start;padding:18px 20px;border-radius:16px;border:2px dashed var(--border-strong)}
+.sx-co2__k{font-size:var(--text-label);font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
+.sx-co2 b{display:block;margin-top:4px;font-family:var(--display);font-size:var(--text-section-head);color:var(--ink)}
+.sx-co2 p{margin:6px 0 0;font-size:var(--text-secondary);line-height:1.55;color:var(--muted)}
+.sx-panel--biz{grid-template-columns:minmax(0,1.6fr) minmax(0,1fr)}
+.sx-eq__head{margin:0 0 6px;font-size:var(--text-eyebrow);font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
+.sx-eq{list-style:none;margin:0;padding:0}
+.sx-eq li{display:grid;grid-template-columns:minmax(0,1fr) auto 100px;gap:14px;align-items:baseline;padding:10px 0;border-bottom:1px solid var(--line-soft)}
+.sx-eq .num{font-size:var(--text-label);color:var(--muted)}
+.sx-eq__m{font-family:var(--data);color:var(--muted)}.sx-eq__m b{color:var(--ink)}
+.sx-eq__r{font-family:var(--data);text-align:right}
+.sx-eq__total{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-top:12px;padding:14px 20px;border-radius:999px;
+  background:var(--teal);color:#fff;font-weight:700}
+.sx-eq__total b{font-family:var(--display);font-size:32px}
+.sx-note{align-self:end;margin:0;font-size:var(--text-secondary);line-height:1.55;color:var(--muted)}
+.sx-sec{width:100%;margin-top:36px}
+.sx-h2{margin:0;font-family:var(--display);font-size:var(--text-section-head);font-weight:700;color:var(--ink)}
+.sx-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;list-style:none;margin:16px 0 0;padding:0}
+.sx-stats li{display:flex;flex-direction:column;gap:6px;padding:18px;border-radius:18px;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-card)}
+.sx-stat__n{font-family:var(--data);font-size:28px;font-weight:700;color:var(--teal-deep)}
+.sx-stats span{font-size:var(--text-secondary);line-height:1.45;color:var(--ink-2)}
+.sx-stats small{font-size:var(--text-label);color:var(--muted)}
+.sx-flow{display:grid;grid-template-columns:repeat(4,1fr);list-style:none;margin:14px 0 0;padding:0;border-radius:20px;overflow:hidden;
+  background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-card)}
+.sx-flow li{display:flex;flex-direction:column;gap:8px;padding:22px;font-size:var(--text-secondary);line-height:1.5;color:var(--muted)}
+.sx-flow li + li{border-left:1px solid var(--line-soft)}
+.sx-flow li:last-child{background:var(--teal-deep);color:#E8F3F0}
+.sx-flow__tag{font-size:var(--text-label);font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--teal)}
+.sx-flow li:last-child .sx-flow__tag{color:#A9E3D9}
+.sx-flow__big{font-family:var(--display);font-size:30px;line-height:1.1;font-weight:700;color:var(--ink)}
+.sx-flow li:last-child .sx-flow__big{color:#fff}
+.sx-who{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;list-style:none;margin:16px 0 0;padding:0}
+.sx-who li{display:flex;flex-direction:column;gap:8px;padding:22px;border-radius:20px;background:#fff;border:1px solid var(--line);
+  box-shadow:var(--shadow-card);font-size:var(--text-secondary);line-height:1.5;color:var(--muted)}
+.sx-who__icon{display:grid;place-items:center;width:48px;height:48px;border-radius:50%;background:var(--teal-tint);font-size:24px}
+.sx-who li:first-child .sx-who__icon,.sx-who li:last-child .sx-who__icon{background:var(--amber-tint)}
+.sx-who__who{font-size:var(--text-label);font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
+.sx-who b{font-family:var(--display);font-size:var(--text-body);font-weight:700;color:var(--ink)}
+.sx-actions{display:flex;flex-wrap:wrap;gap:10px}
+/* motion, only when allowed and armed by JS */
+@media (prefers-reduced-motion:no-preference){
+  #sx-story.is-armed .sx-pk{opacity:0;transform:translateY(-8px)}
+  #sx-story.is-play .sx-pk{animation:sxIn .35s ease-out forwards;animation-delay:calc(var(--i) * 60ms)}
+  #sx-story.is-play .sx-scan{animation:sxScan 1.6s cubic-bezier(.45,0,.55,1) 1.3s forwards}
+  .sx-orbit{animation:sxSpin 30s linear infinite}
+  .sx-earth{animation:sxBob 5s ease-in-out infinite}
+  .sx-panel.is-anim .sx-eq li{opacity:0;transform:translateX(-10px);animation:sxIn .4s ease-out forwards;animation-delay:calc(var(--r) * 300ms + .15s)}
+  .sx-panel.is-anim .sx-eq__total{opacity:0;animation:sxIn .4s ease-out 1.1s forwards}
+}
+.sx-flyer{position:fixed;z-index:50;border-radius:3px;background:var(--amber-strong);pointer-events:none}
+@keyframes sxIn{to{opacity:1;transform:none}}
+@keyframes sxScan{0%{opacity:0;left:0}10%{opacity:1}90%{opacity:1}100%{opacity:0;left:calc(100% - 3px)}}
+@keyframes sxSpin{to{transform:rotate(360deg)}}
+@keyframes sxBob{50%{transform:translateY(-6px)}}
+@keyframes sxHit{50%{transform:scale(1.06)}}
+@media(prefers-reduced-motion:reduce){.sx-play{display:none}}
+@media(max-width:1100px){
+  .sx-hero{grid-template-columns:1fr}
+  .sx-stats,.sx-who{grid-template-columns:1fr 1fr}
+  .sx-flow{grid-template-columns:1fr 1fr}
+  .sx-flow li:nth-child(3){border-left:0}
+  .sx-flow li:nth-child(n+3){border-top:1px solid var(--line-soft)}
+}
+@media(max-width:760px){
+  .sx-head{flex-direction:column;align-items:flex-start}
+  .sx-shelfcard,.sx-impactcard{padding:16px}
+  .sx-row{grid-template-columns:1fr 32px;gap:6px 10px}
+  .sx-row__label{grid-column:1/-1;flex-direction:row;gap:8px;align-items:baseline}
+  .sx-row__track{gap:2px;margin-top:22px}.sx-pk{height:18px}
+  .sx-beats{grid-template-columns:1fr}
+  .sx-panel,.sx-panel--biz{grid-template-columns:1fr}
+  .sx-big{font-size:40px}
+  .sx-eq li{grid-template-columns:1fr auto;gap:4px 12px}
+  .sx-eq li > span:first-child{grid-column:1/-1}
+  .sx-eq__total{border-radius:16px}
+  .sx-stats,.sx-who,.sx-flow{grid-template-columns:1fr}
+  .sx-flow li + li{border-left:0;border-top:1px solid var(--line-soft)}
+}
+.sx-tile b.sx-tile__locked,.sx-big--locked{font-size:var(--text-body)!important;color:var(--muted)!important;font-family:var(--display)}
+.sx-big--locked{margin:0 0 6px}
+.sx-panel--biz .btn{margin-top:14px}
+.sx-empty{margin:0;padding:28px;border-radius:16px;background:#F7FAF9;color:var(--muted);font-size:var(--text-body);line-height:1.6}
+.sx-shelf{overflow-x:clip}
