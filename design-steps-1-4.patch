+
+/* ===== aligned top bar (same as the homepage and the HTML previews) =====
+   The logo starts on the content column's left edge at every width, 36px tall,
+   with the Homepage pill and the language pill on the right. */
+.frame { --gx: 40px; }
+@media (max-width: 1240px) { .frame { --gx: 32px; } }
+@media (max-width: 1180px) { .frame { --gx: 24px; } }
+@media (max-width: 760px) { .frame { --gx: 20px; } }
+.frame .topbar { min-height: 66px; height: auto; gap: 12px; padding-top: 0; padding-bottom: 0;
+  padding-left: max(var(--gx), calc((100% - var(--shell)) / 2 + var(--gx)));
+  padding-right: max(var(--gx), calc((100% - var(--shell)) / 2 + var(--gx)));
+  background: #fff; border-bottom: 1px solid var(--line-soft); }
+.frame .topbar .brand { padding: 0; margin-left: 0; line-height: 0; }
+.frame .topbar .brand__logo { height: 36px !important; }
+.frame .topbar .workspace-home-link { min-height: 38px; padding: 0 15px; font-family: var(--display); font-weight: 700; }
+@media (max-width: 1100px) { .frame .topbar { padding-top: 10px; padding-bottom: 10px; } }
+
+/* ===== type alignment (same as the HTML previews) =====
+   Names Manrope 700, descriptions Source Sans 3 400, marks uppercase Manrope 800, numbers Inter. */
+.frame h1, .frame h2, .frame h3, .frame h4, .frame th, .frame legend, .frame summary, .frame dt, .frame .btn { font-family: var(--display); }
