 * { scrollbar-width: thin; scrollbar-color: var(--border-strong) transparent; }
+
+/* ===== Step 1 (upload) layout =====
+   Guidance on the left, the drop zone on the right; one column once there is
+   no longer room for the drop zone to keep its shape. */
+.s1-layout {
+  display: grid;
+  grid-template-columns: minmax(0, 1.05fr) minmax(380px, 0.95fr);
+  gap: var(--space-10);
+  align-items: start;
+}
+@media (max-width: 980px) {
+  .s1-layout { grid-template-columns: 1fr; gap: var(--space-8); }
+}
+
+/* ===== interactive purchase-plan example =====
+   Evidence on the left, the controls and the verdict on the right. Stacks
+   once the control column can no longer hold its stepper rows. */
+.ex-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(360px, 420px);
+  gap: var(--space-4);
+  align-items: start;
+}
+@media (max-width: 1040px) {
+  .ex-grid { grid-template-columns: 1fr; }
+}
+@media (max-width: 720px) {
+  .ex-weeks { grid-template-columns: repeat(4, minmax(0, 1fr)) !important; }
+  .ex-summary { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
+}
+
+/* ===== sliders =====
+   A default range input renders as a hairline on macOS — easy to miss
+   entirely. These are drawn to match the mockup: a thick rounded track, a
+   teal fill up to the current value, and a thumb big enough to grab. The
+   fill comes from --sl-track, set inline from the value. */
+.sl-range {
+  -webkit-appearance: none;
+  appearance: none;
+  display: block;
+  width: 100%;
+  height: 28px;
+  margin: 0;
+  background: transparent;
+  cursor: pointer;
+}
+.sl-range::-webkit-slider-runnable-track {
+  height: 10px;
+  border-radius: 999px;
+  background: var(--sl-track, #DCE6E3);
+  border: 1px solid var(--line);
+}
+.sl-range::-webkit-slider-thumb {
+  -webkit-appearance: none;
+  appearance: none;
+  margin-top: -9px;
+  width: 26px;
+  height: 26px;
+  border-radius: 50%;
+  background: #fff;
+  border: 3px solid var(--teal);
+  box-shadow: 0 2px 6px rgba(22, 49, 59, .25);
+  cursor: grab;
+}
+.sl-range:active::-webkit-slider-thumb { cursor: grabbing; }
+.sl-range::-moz-range-track {
+  height: 10px;
+  border-radius: 999px;
+  background: #DCE6E3;
+  border: 1px solid var(--line);
+}
+.sl-range::-moz-range-progress { height: 10px; border-radius: 999px; background: var(--teal); }
+.sl-range::-moz-range-thumb {
+  width: 22px;
+  height: 22px;
+  border-radius: 50%;
+  background: #fff;
+  border: 3px solid var(--teal);
+  box-shadow: 0 2px 6px rgba(22, 49, 59, .25);
+  cursor: grab;
+}
+.sl-range:focus-visible { outline: 2px solid var(--teal); outline-offset: 4px; }
+
+/* ===== language switcher =====
+   The same control the workspace uses, so the prototype and the app read as
+   one product. A native select gets the phone's own picker for free. */
+.language-switcher {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  background: #edf7ef;
+  border: 1px solid #c3e2cc;
+  border-radius: 10px;
+  padding: 6px 8px;
+  color: #2f6c49;
+  flex-shrink: 0;
+  line-height: 1.3;
+}
+.language-switcher select {
+  font-family: inherit;
+  font-size: 12px;
+  font-weight: 600;
+  line-height: 1.4;
+  color: inherit;
+  background: transparent;
+  border: 0;
+  padding: 4px 0;
+  cursor: pointer;
+  max-width: 120px;
+  min-height: 28px;
+}
+.language-switcher:focus-within { outline: 2px solid var(--teal); outline-offset: 3px; }
+@media (max-width: 600px) {
+  .language-switcher { padding: 4px; }
+  .language-switcher svg { width: 23px; }
+  .language-switcher select { max-width: 102px; }
+}
+
+/* ===== top bar =====
+   Four controls in one row need about 590px; a phone gives 342px, so below
+   760px the row wraps instead of running off the edge. */
+.sl-topnav {
+  height: 56px;
+  display: flex;
+  align-items: center;
+  gap: var(--space-4);
+}
+@media (max-width: 760px) {
+  .sl-topnav {
+    height: auto;
+    min-height: 56px;
+    padding-top: 10px !important;
+    padding-bottom: 10px !important;
+    flex-wrap: wrap;
+    row-gap: 10px;
+    justify-content: flex-end;
+  }
+  /* the preview toggle is a demo control — it drops to its own line first */
+  .sl-topnav > div:nth-of-type(1) { order: 3; margin-right: auto; }
+}
