diff --git a/src/decor.css b/src/decor.css
new file mode 100644
index 0000000..5cdfd34
--- /dev/null
+++ b/src/decor.css
@@ -0,0 +1,101 @@
+/* Decorative background bands — see src/components/Decor.tsx.
+   Applied to the hero and to the foot of the page only, never behind the
+   sections in between, and always with a pale clearing over the middle so
+   headings and body copy stay fully legible. */
+
+.sl-band { position: relative; isolation: isolate; }
+.sl-band > * { position: relative; z-index: 2; }
+
+.sl-decor {
+  position: absolute;
+  left: 0;
+  right: 0;
+  z-index: 0;
+  pointer-events: none;
+  overflow: hidden;
+  background: #FCFCF9;
+}
+.sl-decor svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
+
+/* each band stretches to the section it wraps, so the artwork never
+   spills onto the section below */
+.sl-decor--hero { top: 0; bottom: 0; min-height: 420px; }
+.sl-decor--foot { top: 0; bottom: 0; }
+
+/* the clearing, plus a fade into the page colour on the open edge */
+.sl-decor--hero::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  background:
+    radial-gradient(40% 34% at 50% 34%, rgba(252,252,249,.94) 0%, rgba(252,252,249,.72) 52%, rgba(252,252,249,0) 80%),
+    linear-gradient(to bottom, rgba(252,252,249,0) 74%, var(--page) 100%);
+}
+.sl-decor--foot::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  background:
+    radial-gradient(46% 40% at 50% 40%, rgba(252,252,249,.92) 0%, rgba(252,252,249,.7) 54%, rgba(252,252,249,0) 82%),
+    linear-gradient(to top, rgba(252,252,249,0) 78%, var(--page) 100%);
+}
+
+/* the basket clears both the headline and the interactive card beside it */
+.sl-basket {
+  position: absolute;
+  right: 0;
+  bottom: 0;
+  width: clamp(140px, 18vw, 264px);
+  height: auto;
+  z-index: 1;
+  display: block;
+}
+
+@media (max-width: 1050px) {
+  .sl-decor--hero { min-height: 360px; }
+}
+
+@media (max-width: 760px) {
+  .sl-decor--hero { min-height: 300px; }
+  /* narrow screens leave no clear column beside the copy, so the basket is
+     dropped rather than allowed to sit under the text */
+  .sl-basket { display: none; }
+  .sl-decor--hero::after {
+    background:
+      radial-gradient(86% 46% at 50% 34%, rgba(252,252,249,.97) 0%, rgba(252,252,249,.9) 56%, rgba(252,252,249,.2) 100%),
+      linear-gradient(to bottom, rgba(252,252,249,0) 72%, var(--page) 100%);
+  }
+  .sl-decor--foot::after {
+    background:
+      radial-gradient(90% 50% at 50% 42%, rgba(252,252,249,.96) 0%, rgba(252,252,249,.88) 58%, rgba(252,252,249,.2) 100%),
+      linear-gradient(to top, rgba(252,252,249,0) 76%, var(--page) 100%);
+  }
+}
+
+/* ===== food-waste statistics row =====
+   Four fixed columns squeezed each description into one word per line at
+   common widths. Auto-fit with a sensible minimum lets it fall to two
+   columns, then one, instead of shredding the text. */
+.sl-stats {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: var(--space-6);
+}
+.sl-stat { min-width: 0; padding-left: var(--space-5); }
+.sl-stat--ruled { border-left: 1px solid var(--line); }
+
+@media (max-width: 900px) {
+  .sl-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--space-8); }
+  /* the rule only reads as a divider on the columns that have one beside them */
+  .sl-stat:nth-child(odd) { border-left: none; padding-left: 0; }
+}
+@media (max-width: 520px) {
+  .sl-stats { grid-template-columns: 1fr; }
+  .sl-stat { border-left: none; padding-left: 0; }
+}
+
+/* The hero and footer artwork is drawn with preserveAspectRatio="slice", so on a
+   phone its paths extend well past the viewport. The SVG clips them visually,
+   but they still widen the scrollable area — the page could be dragged ~280px
+   sideways. `clip` stops that without making a scroll container. */
+html, body { overflow-x: clip; }
