@@ -0,0 +1,41 @@
+/* Minimal stand-in for react-router, used only by the standalone HTML build.
+   The real app keeps using react-router; this exists so the exported single
+   file can route from file:// where a history API router cannot work. */
+import React, { createContext, useContext, useEffect, useState } from 'react';
+
+type RouteDef = { path?: string; index?: boolean; Component: React.ComponentType; children?: RouteDef[] };
+const Ctx = createContext<{ path: string; go: (to: string) => void }>({ path: '/', go: () => {} });
+const OutletCtx = createContext<React.ReactNode>(null);
+
+const read = () => (location.hash.replace(/^#/, '') || '/');
+
+export function createBrowserRouter(routes: RouteDef[]) { return { routes }; }
+
+export function RouterProvider({ router }: { router: { routes: RouteDef[] } }) {
+  const [path, setPath] = useState(read);
+  useEffect(() => {
+    const on = () => setPath(read());
+    addEventListener('hashchange', on);
+    return () => removeEventListener('hashchange', on);
+  }, []);
+  const go = (to: string) => { location.hash = to; };
+
+  const root = router.routes[0];
+  const kids = root.children || [];
+  const rel = path === '/' ? '' : path.replace(/^\//, '');
+  const match = kids.find((r) => (rel === '' ? r.index : r.path === rel)) || kids.find((r) => r.index);
+  const Root = root.Component;
+  const Child = match?.Component;
+
+  return (
+    <Ctx.Provider value={{ path, go }}>
+      <OutletCtx.Provider value={Child ? <Child /> : null}>
+        <Root />
+      </OutletCtx.Provider>
+    </Ctx.Provider>
+  );
+}
+
+export function Outlet() { return <>{useContext(OutletCtx)}</>; }
+export function useLocation() { return { pathname: useContext(Ctx).path }; }
+export function useNavigate() { return useContext(Ctx).go; }
