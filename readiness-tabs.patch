+import { afterEach, describe, expect, it, vi } from "vitest";
+import { cleanup, fireEvent, render, screen, within } from "@testing-library/react";
+import { ReadinessRowsTab, summariseRows } from "../src/screens/ReadinessRowsTab.tsx";
+import { buildProductTimelines } from "../src/engine.ts";
+import { buildFindings, buildReadinessProducts } from "../src/readiness/model.ts";
+import { setLanguage } from "../src/i18n/index.ts";
+import { makeEvidence } from "./fixtures.ts";
+
+afterEach(() => { cleanup(); setLanguage("en"); });
+
+function withOneBadDate() {
+  const { snapshot } = makeEvidence();
+  const sourceRow = snapshot.rows[0].sourceRow;
+  const issue = { id: "date-issue", sourceRow, issueCode: "INVALID_DATE" as const, observedValue: "2026-13-45", reason: "Invalid date", correctiveAction: "Fix date", resolutionState: "unresolved" as const };
+  const changed = {
+    ...snapshot,
+    rows: snapshot.rows.map((row, index) => index === 0 ? { ...row, useState: "excluded" as const } : row),
+    issues: [issue],
+    reconciliation: { ...snapshot.reconciliation, rowsUsed: snapshot.rows.length - 1, rowsExcluded: 1 },
+  };
+  const findings = buildFindings(changed, buildReadinessProducts(changed, buildProductTimelines(changed)));
+  return { snapshot: changed, findings };
+}
+
+describe("Step 3 rows tab", () => {
+  it("counts every left-out row exactly once", () => {
+    const { snapshot, findings } = withOneBadDate();
+    const summary = summariseRows(snapshot, findings);
+    expect(summary.rowsUsed).toBe(snapshot.rows.length - 1);
+    expect(summary.reasons.reduce((sum, reason) => sum + reason.rows, 0)).toBe(1);
+  });
+
+  it("shows the headline, the reasons and a next step that links to What we found", () => {
+    const { snapshot, findings } = withOneBadDate();
+    const onShowGroup = vi.fn(), onDownload = vi.fn();
+    render(<ReadinessRowsTab snapshot={snapshot} findings={findings} onShowGroup={onShowGroup} onDownload={onDownload} />);
+    const tab = screen.getByTestId("readiness-rows-tab");
+    expect(tab.textContent).toContain(`of ${snapshot.rows.length} rows will be used`);
+    const reasons = screen.getByRole("radiogroup", { name: "Why 1 row was left out" });
+    expect(within(reasons).getAllByRole("radio")).toHaveLength(1);
+    expect(screen.getByText("Fix 1 row in your file")).toBeTruthy();
+    const link = screen.queryByRole("button", { name: /Show these rows/ });
+    if (link) { fireEvent.click(link); expect(onShowGroup).toHaveBeenCalledOnce(); }
+    fireEvent.click(screen.getByRole("button", { name: "Download all row evidence" }));
+    expect(onDownload).toHaveBeenCalledOnce();
+  });
+
+  it("says there is nothing to fix when every row is used", () => {
+    const { snapshot } = makeEvidence();
+    render(<ReadinessRowsTab snapshot={snapshot} findings={[]} onShowGroup={vi.fn()} onDownload={vi.fn()} />);
+    expect(screen.getByText("Nothing to fix — every row can be used.")).toBeTruthy();
+  });
+});
