index 0000000..ba7bf59
--- /dev/null
+++ b/frontend/src/screens/ReadinessRowsTab.tsx
@@ -0,0 +1,104 @@
+import { useMemo, useState } from "react";
+import { getLocale, t, useLanguage } from "../i18n/index.ts";
+import type { ReadinessSnapshot } from "../engine.ts";
+import type { Finding, FindingType } from "../readiness/model.ts";
+
+/** Plain-language row summary: how many rows are used, why the rest were left out, and what to do. */
+const REASON_ORDER: readonly FindingType[] = ["date", "quantity", "identity", "stock", "other"];
+export const REASON_LABELS: Record<FindingType | "unexplained", string> = {
+  date: "Dates we couldn't read", quantity: "Quantities to check", identity: "Rows with no product",
+  stock: "Stock counts to check", other: "Other things to check", tidy: "Safe tidy-ups applied", unexplained: "Other reasons",
+};
+
+/** "readiness|" keys are number templates; the prefix keeps the patterns away from other screens' strings. */
+const fill = (text: string, values: readonly (string | number)[]) => text.replace(/\{(\d+)\}/g, (_, i: string) => String(values[Number(i)] ?? ""));
+export function tr(english: string, ...values: (string | number)[]) {
+  const key = `readiness|${english}`;
+  const translated = t(key);
+  return fill(translated === key ? english : translated, values);
+}
+
+export interface RowReason {
+  readonly type: FindingType | "unexplained";
+  readonly rows: number;
+  readonly example?: Finding;
+  readonly sourceRows: readonly number[];
+}
+
+/** Each left-out row is counted once, under the first reason (in "What we found" order) that mentions it. */
+export function summariseRows(snapshot: ReadinessSnapshot, findings: readonly Finding[]) {
+  const { rowsIn, rowsUsed, rowsExcluded } = snapshot.reconciliation;
+  const assigned = new Set<number>();
+  const reasons: RowReason[] = [];
+  for (const type of REASON_ORDER) {
+    const group = findings.filter(item => item.type === type && item.status === "out");
+    const rows = [...new Set(group.flatMap(item => item.sourceRows))].filter(row => !assigned.has(row));
+    rows.forEach(row => assigned.add(row));
+    if (rows.length) reasons.push({ type, rows: rows.length, example: group[0], sourceRows: rows.sort((a, b) => a - b) });
+  }
+  const unexplained = Math.max(0, rowsExcluded - assigned.size);
+  if (unexplained) reasons.push({ type: "unexplained", rows: unexplained, sourceRows: [] });
+  const tidied = new Set(findings.filter(item => item.type === "tidy").flatMap(item => item.sourceRows)).size;
+  return { rowsIn, rowsUsed, rowsExcluded, tidied, reasons };
+}
+
+interface Props {
+  readonly snapshot: ReadinessSnapshot;
+  readonly findings: readonly Finding[];
+  /** Shows the chosen group in "What we found" below. */
+  readonly onShowGroup: (type: FindingType) => void;
+  readonly onDownload: () => void;
+}
+
+export function ReadinessRowsTab({ snapshot, findings, onShowGroup, onDownload }: Props) {
+  useLanguage();
+  const summary = useMemo(() => summariseRows(snapshot, findings), [snapshot, findings]);
+  const [picked, setPicked] = useState(0);
+  const number = (value: number) => value.toLocaleString(getLocale());
+  const { rowsIn, rowsUsed, rowsExcluded, tidied, reasons } = summary;
+  const current = reasons[Math.min(picked, reasons.length - 1)];
+  const largest = Math.max(1, ...reasons.map(reason => reason.rows));
+  const listedRows = (rows: readonly number[]) => rows.slice(0, 4).map(number).join(", ") + (rows.length > 4 ? "…" : "");
+
+  return <div className="rd-rows" data-testid="readiness-rows-tab">
+    <div className="rd-rows__head">
+      <p className="rd-rows__headline"><b className="num">{number(rowsUsed)}</b> {tr("of {0} rows will be used", number(rowsIn))}</p>
+      <span className="rd-rows__safe">✓ {t("Your file isn't changed")}</span>
+    </div>
+    <div className="rd-rows__bar" role="img" aria-label={tr("{0} rows used, {1} left out", number(rowsUsed), number(rowsExcluded))}>
+      <span className="rd-rows__used" style={{ flexGrow: rowsUsed }} />
+      {rowsExcluded > 0 && <span className="rd-rows__out" style={{ flexGrow: rowsExcluded }} />}
+    </div>
+    <ul className="rd-rows__legend">
+      <li><i className="rd-rows__key rd-rows__key--used" />{t("Used in the plan")} · <b className="num">{number(rowsUsed)}</b></li>
+      <li><i className="rd-rows__key rd-rows__key--out" />{t("Left out")} · <b className="num">{number(rowsExcluded)}</b></li>
+      {tidied > 0 && <li><i className="rd-rows__key rd-rows__key--tidy" />{t("Tidied for you (still used)")} · <b className="num">{number(tidied)}</b></li>}
+    </ul>
+
+    {reasons.length === 0 ? <p className="rd-rows__none">{t("Nothing to fix — every row can be used.")}</p> :
+      <div className="rd-rows__grid">
+        <div className="rd-rows__reasons">
+          <h3 className="rd-rows__h">{rowsExcluded === 1 ? t("Why 1 row was left out") : tr("Why {0} rows were left out", number(rowsExcluded))}</h3>
+          <div role="radiogroup" aria-label={rowsExcluded === 1 ? t("Why 1 row was left out") : tr("Why {0} rows were left out", number(rowsExcluded))}>
+            {reasons.map((reason, index) => <button key={reason.type} type="button" role="radio" aria-checked={reason === current}
+              className={"rd-rows__reason" + (reason === current ? " is-on" : "")} onClick={() => setPicked(index)}>
+              <span className="rd-rows__label">{t(REASON_LABELS[reason.type])}</span>
+              <span className="rd-rows__meter" aria-hidden="true"><span style={{ width: `${Math.round(100 * reason.rows / largest)}%` }} /></span>
+              <b className="num">{number(reason.rows)}</b>
+            </button>)}
+          </div>
+        </div>
+        <div className="rd-rows__todo" aria-live="polite">
+          <h3 className="rd-rows__h">{t("What to do")}</h3>
+          <b>{current.type === "unexplained" ? t("Download the list to see these rows") : current.rows === 1 ? t("Fix 1 row in your file") : tr("Fix {0} rows in your file", number(current.rows))}</b>
+          {current.example && <p>{t(current.example.action)}</p>}
+          {current.sourceRows.length > 0 && <p className="rd-rows__where">{t("Rows")} <span className="num">{listedRows(current.sourceRows)}</span>{current.example?.observed ? <> · <code>{current.example.observed}</code></> : null}</p>}
+          <p className="rd-rows__note">{t("Or continue now — these rows are simply left out of the plan.")}</p>
+          <div className="rd-rows__links">
+            {current.type !== "unexplained" && <button type="button" className="btn--link" onClick={() => onShowGroup(current.type as FindingType)}>{t("Show these rows in “What we found” ↓")}</button>}
+            <button type="button" className="btn--link" onClick={onDownload}>{t("Download all row evidence")}</button>
+          </div>
+        </div>
+      </div>}
+  </div>;
+}
