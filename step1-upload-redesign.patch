+/* ===== workspace background =====
+   Quieter than the homepage: pinned to the viewport, artwork only in the
+   margins, and a clearing over the centre column so cards and tables stay
+   fully legible. Decorative only — never intercepts a click. */
+.ws-decor{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}
+.ws-decor svg{position:absolute;inset:0;width:100%;height:100%;display:block}
+.ws-decor::after{content:"";position:absolute;inset:0;
+  background:radial-gradient(58% 64% at 50% 46%,
+    var(--page) 0%, rgba(247,249,248,.86) 52%, rgba(247,249,248,0) 82%)}
+/* everything the shell renders sits above the artwork */
+.frame > *:not(.ws-decor){position:relative;z-index:1}
+@media(max-width:900px){
+  /* no free margin left beside the content at this width */
+  .ws-decor{display:none}
+}
