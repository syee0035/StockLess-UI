+/** Part-to-whole at a glance; the legend carries every exact count and share. */
+function QualityDonut(props: {
+  readonly usable: number;
+  readonly slices: readonly { key: string; label: string; value: number; hue: string }[];
+}) {
+  const total = props.usable + props.slices.reduce((sum, slice) => sum + slice.value, 0);
+  const parts = [{ key: "usable", label: "Usable rows", value: props.usable, hue: VIZ.usable }, ...props.slices]
+    .filter((part) => part.value > 0);
+  const circumference = 2 * Math.PI * 54;
+  let offset = 0;
+  return (
+    <div className="donut">
+      <div className="donut__ring">
+        <svg viewBox="0 0 140 140" width="140" height="140" role="img"
+          aria-label={`${props.usable} ${t("of")} ${total} ${t("rows are usable")}`}>
+          <circle cx="70" cy="70" r="54" fill="none" stroke="var(--line-soft)" strokeWidth="16" />
+          {t(parts.map((part) => {
+            const length = (part.value / total) * circumference;
+            const dash = Math.max(0, length - 2); /* the 2px surface gap */
+            const element = (
+              <circle key={part.key} cx="70" cy="70" r="54" fill="none" stroke={part.hue} strokeWidth="16"
+                strokeDasharray={`${dash} ${circumference - dash}`}
+                strokeDashoffset={-offset} transform="rotate(-90 70 70)" />
+            );
+            offset += length;
+            return element;
+          }))}
+        </svg>
+        <div className="donut__centre">
+          <b>{t(total.toLocaleString("en"))}</b>
+          <span>{t("Total rows")}</span>
+        </div>
+      </div>
+      <ul className="donut__legend">
+        {t([{ key: "usable", label: "Usable rows", value: props.usable, hue: VIZ.usable }, ...props.slices]
+          .map((part) => (
+            <li key={part.key}>
+              <span className="donut__swatch" style={{ background: part.hue }} aria-hidden="true" />
+              <span className="donut__name">{t(part.label)}</span>
+              <span className="donut__count">{t(part.value.toLocaleString("en"))}</span>
+              <span className="donut__share">{t(total === 0 ? "0%" : `${Math.round((part.value / total) * 100)}%`)}</span>
+            </li>
+          )))}
+      </ul>
+    </div>
+  );
+}
