+/** Weekly sales volume across the whole file. Single series, so no legend. */
+function SalesOverview(props: { readonly timelines: readonly ProductTimeline[] }) {
+  const byWeek = new Map<string, number>();
+  for (const timeline of props.timelines) {
+    for (const week of timeline.weeks) {
+      if (week.state !== "observed_demand" || week.netQuantity === null) continue;
+      byWeek.set(week.weekStart, (byWeek.get(week.weekStart) ?? 0) + week.netQuantity);
