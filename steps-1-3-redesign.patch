+
+
+/* ===== workspace background =====
+   The artwork lives in the two gutters beside the 1180px content column and
+   nowhere else, so nothing is ever drawn under a heading, card or table.
+   Below 1330px there is no gutter left, so it is dropped rather than allowed
+   behind the text. Decorative only — never intercepts a click. */
+.ws-decor{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}
+.ws-decor__side{position:absolute;top:0;bottom:0;width:calc((100% - var(--shell)) / 2);overflow:hidden}
+.ws-decor__side--left{left:0}
+.ws-decor__side--right{right:0;transform:scaleX(-1)}
+.ws-decor__side svg{position:absolute;inset:0;width:100%;height:100%;display:block}
+/* everything the shell renders sits above the artwork */
+.frame > *:not(.ws-decor){position:relative;z-index:1}
+@media(max-width:1330px){
+  /* the content column now fills the width — no gutter left to draw in */
+  .ws-decor{display:none}
+}
+
+/* ===== upload screen: value chain under the drop zone =====
+   Four steps with a line icon above each label, arrows in between, aligned
+   to the icon row rather than the text so the arrows read as connectors. */
+.value-chain{display:flex;align-items:flex-start;justify-content:center;flex-wrap:wrap;
+  gap:4px 2px;list-style:none;margin:22px 0 0;padding:0}
+.value-chain li{display:flex;align-items:flex-start;gap:6px}
+.value-chain__step{display:flex;flex-direction:column;align-items:center;gap:8px;
+  width:86px;text-align:center}
+.value-chain__icon{color:var(--teal);line-height:0}
+.value-chain__label{font-family:var(--body);font-size:var(--text-description);font-weight:600;
+  line-height:1.35;color:var(--muted)}
+.value-chain li:not(:last-child)::after{content:"→";margin-top:8px;font-size:var(--text-body);
+  color:var(--border-strong)}
+.value-chain__end .value-chain__label{color:var(--teal-deep);font-weight:700}
+@media(max-width:520px){
+  .value-chain li:not(:last-child)::after{display:none}
+  .value-chain__step{width:120px}
+}
+.card-title--sprout::before{content:"🌱";margin-right:8px}
+
+/* ===== back to the homepage =====
+   A bare text link in the top bar read as body copy; this gives it a button
+   shape so it is obviously somewhere to click. The logo goes home too. */
+.topbar .workspace-home-link{display:inline-flex;align-items:center;gap:7px;margin-left:auto;
+  padding:9px 15px;border:1px solid var(--line);border-radius:999px;background:#fff;
+  font-family:var(--body);font-size:var(--text-secondary);font-weight:700;line-height:1;
+  color:var(--teal-deep);text-decoration:none;white-space:nowrap;
+  transition:background-color .15s ease,border-color .15s ease}
+.topbar .workspace-home-link:hover{background:var(--teal-tint);border-color:var(--mint);text-decoration:none}
+.topbar .workspace-home-link svg{flex:none}
+.brand{transition:opacity .15s ease}
+.brand:hover{opacity:.78}
+
+/* ===== top bar on a narrow screen =====
+   Logo, Homepage and the language switcher need about 460px; below roughly
+   560px they no longer fit on one line. Rather than letting the switcher fall
+   to the left while the button stays right, the logo takes the first row and
+   the two controls sit together, right-aligned, on the second.
+   Selectors are doubled up so this wins wherever language.css is loaded. */
+@media (max-width:560px){
+  .frame .topbar{height:auto;min-height:76px;padding-top:14px;padding-bottom:14px;
+    flex-wrap:wrap;justify-content:flex-end;row-gap:12px;column-gap:10px}
+  .frame .topbar .brand{flex:1 0 100%}
+  .frame .topbar .workspace-home-link{margin-left:0}
+}
+
+/* ===== step 2: confirmation states =====
+   A semantic system rather than green everywhere:
+   sage = confirmed, amber = needs attention, red = error. */
+.pill--confirmed{background:#EDF3EE;color:#3F7A5D;border:1px solid #D8E6DA}
+.all-set{display:flex;align-items:center;gap:9px;margin:18px 0 0;padding:12px 15px;
+  background:#EDF3EE;border:1px solid #D8E6DA;border-radius:12px;
+  font-size:var(--text-body);font-weight:700;color:#3F7A5D}
+
+/* ===== step 2: guidance panel =====
+   Was a dark teal block that read as a separate product. As a sage card it
+   belongs to the same design system as the rest of the screen. */
+.panel-sage{width:330px;flex:none;padding:24px;border-radius:22px;
+  background:#F1F8F3;border:1px solid #D8E6DA;color:var(--ink)}
+.panel-sage__title{display:flex;align-items:center;gap:9px;margin:0;
+  font-family:var(--display);font-size:var(--text-section-head);font-weight:700}
+.panel-sage__subtitle{margin:26px 0 0;font-family:var(--display);
+  font-size:var(--text-body);font-weight:700}
+.panel-sage__lede{margin:7px 0 0;font-size:var(--text-secondary);line-height:1.5;color:var(--muted)}
+
+.sage-steps,.sage-formats{list-style:none;margin:14px 0 0;padding:0;counter-reset:sage}
+.sage-steps li,.sage-formats li{counter-increment:sage;position:relative;
+  padding-left:30px;margin-bottom:11px;font-size:var(--text-secondary);line-height:1.45;color:var(--ink-2)}
+.sage-steps li::before,.sage-formats li::before{content:counter(sage);position:absolute;left:0;top:0;
+  width:20px;height:20px;border-radius:50%;background:#DCEEE2;color:#3F7A5D;
+  font-size:var(--text-label);font-weight:800;display:flex;align-items:center;justify-content:center}
+.sage-formats li b{display:block;font-size:var(--text-secondary);color:var(--ink)}
+.sage-formats li span{color:var(--muted)}
+
+.panel-sage__privacy{display:flex;align-items:flex-start;gap:11px;margin:24px 0 0;padding-top:18px;
+  border-top:1px solid #D8E6DA;font-size:var(--text-description);line-height:1.5;color:var(--muted)}
+.panel-sage__lock{width:28px;height:28px;flex:none;border-radius:50%;background:#DCEEE2;color:var(--teal-deep);
+  display:flex;align-items:center;justify-content:center}
+.panel-sage__privacy b{display:block;color:var(--ink);font-size:var(--text-secondary);margin-bottom:2px}
+
+/* the two identity formats are numbered choices, not a wall of text */
+.identity__path-name{display:flex;align-items:center;gap:9px}
+.identity__path-number{width:20px;height:20px;flex:none;border-radius:50%;
+  background:var(--teal-tint);color:var(--teal-deep);font-size:var(--text-label);font-weight:800;
+  display:flex;align-items:center;justify-content:center}
+
+@media (max-width:1240px){ .panel-sage{width:100%} }
+
+/* The status pill is nowrap everywhere else, which is right — but in the
+   mapping table it runs past the narrow status column, so let it wrap there. */
+.dtable .mapping-status .pill{white-space:normal;line-height:1.35;text-align:left}
+
+/* ===== product readiness =====
+   Step 3 leads with products, not charts: which product, what is wrong,
+   how bad, what now. The charts are still here, one fold down. */
+.summary{align-self:stretch;display:grid;grid-template-columns:minmax(230px,.9fr) minmax(0,2fr);
+  gap:18px;align-items:center;margin-top:16px;padding:16px 18px;
+  background:var(--teal-tint);border:1px solid #CFE3DE;border-radius:16px}
+.summary__verdict{display:flex;align-items:center;gap:13px}
+.summary__tick{width:40px;height:40px;flex:none;border-radius:50%;background:var(--teal);color:#fff;
+  display:flex;align-items:center;justify-content:center;font-size:19px}
+.summary__verdict h2{font-family:var(--display);font-size:var(--text-section-head);font-weight:700;margin:0}
+.summary__verdict p{font-size:var(--text-secondary);color:var(--muted);margin:2px 0 0}
+.summary__groups{list-style:none;margin:0;padding:0;display:grid;
+  grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
+.summary__group{display:grid;grid-template-columns:auto minmax(0,1fr);grid-template-rows:auto auto;
+  column-gap:10px;padding:10px 13px;border-radius:12px;background:#fff;border:1px solid var(--line)}
+.summary__group b{grid-row:1 / span 2;align-self:center;font-family:var(--display);font-size:25px;font-weight:800;line-height:1}
+.summary__name{font-size:var(--text-secondary);font-weight:700;color:var(--ink)}
+.summary__note{font-size:var(--text-label);color:var(--muted);line-height:1.35}
+.summary__group--ready{background:#F1F8F5;border-color:#CFE3DE}
+.summary__group--ready b{color:var(--teal-deep)}
+.summary__group--review{background:#FDF7EC;border-color:#EFE0C4}
+.summary__group--review b{color:#8A5A12}
+.summary__group--missing{background:#FDF3F2;border-color:#F0D6D2}
+.summary__group--missing b{color:#9B3939}
+
+.nextstep{align-self:stretch;margin:11px 0 0;font-size:var(--text-body);color:var(--ink-2)}
+.nextstep b{color:var(--ink)}
+
+.attention{align-self:stretch;margin-top:16px}
+.attention__head{display:flex;align-items:flex-start;gap:12px;padding:13px 16px;
+  background:#FDF3F2;border:1px solid #F0D6D2;border-radius:14px}
+.attention__icon{width:30px;height:30px;flex:none;border-radius:50%;background:#9B3939;color:#fff;
+  display:flex;align-items:center;justify-content:center;font-weight:800}
+.attention__head h2{font-family:var(--display);font-size:17px;font-weight:700;margin:0;color:#7E2E2E}
+.attention__head p{font-size:var(--text-description);color:var(--muted);margin:3px 0 0}
+.attention__sort{margin-left:auto;flex:none}
+.attention__sort select{font-family:var(--body);font-size:var(--text-description);color:var(--ink-2);
+  padding:7px 10px;border:1px solid var(--line);border-radius:9px;background:#fff}
+
+.pcards{display:grid;grid-template-columns:repeat(auto-fit,minmax(310px,1fr));gap:12px;margin-top:12px}
+.pcard{display:flex;flex-direction:column;gap:10px;padding:15px;background:#fff;
+  border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow-card)}
+.pcard__head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
+.pcard__name{display:block;font-family:var(--display);font-size:var(--text-body);font-weight:700;color:var(--ink)}
+.pcard__code{display:block;font-size:var(--text-description);color:var(--muted);margin-top:2px}
+.pcard__facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
+.pcard__facts>div{padding:9px 11px;background:#F7FAF9;border-radius:10px}
+.pcard__key{display:block;font-size:var(--text-label);color:var(--muted);text-transform:uppercase;letter-spacing:.5px}
+.pcard__facts b{font-size:var(--text-secondary);color:var(--ink);font-family:var(--data)}
+.pcard__trend .pcard__key{margin-bottom:5px}
+.pcard__why{display:flex;align-items:flex-start;gap:8px;margin:0;padding:9px 11px;border-radius:10px;
+  font-size:var(--text-description);line-height:1.45}
+.pcard__why>span:first-child{width:15px;height:15px;flex:none;border-radius:50%;font-size:var(--text-label);
+  font-weight:800;display:flex;align-items:center;justify-content:center;margin-top:1px}
+.pcard__why>span:not(:first-child){flex:1;min-width:0}
+.pcard__why--review{background:#FDF7EC;color:#7A5210}
+.pcard__why--review>span:first-child{background:#E8D4AC;color:#7A5210}
+.pcard__why--missing{background:#FDF3F2;color:#7E2E2E}
+.pcard__why--missing>span:first-child{background:#F0D0CC;color:#7E2E2E}
+.pcard__action{align-self:stretch;justify-content:center;margin-top:auto}
+
+/* weekly sales for one product — never called stock: the file carries one
+   stock count, not a weekly stock level */
+.spark{display:flex;align-items:flex-end;gap:3px;height:28px}
+.spark--labelled{height:52px}
+.spark--empty{font-size:var(--text-label);color:var(--muted);align-items:center}
+.spark__col{flex:1;min-width:5px;display:flex;flex-direction:column;align-items:center;
+  justify-content:flex-end;height:100%;gap:2px}
+.spark__value,.spark__day{font-size:var(--text-label);color:var(--muted);font-family:var(--data);line-height:1}
+.spark__bar{width:100%;max-width:18px;background:var(--mint);border-radius:3px 3px 0 0;min-height:3px}
+.spark--labelled .spark__bar{background:#B9DED4}
+.spark__bar--missing{height:7px;border:1px dashed #6E7B80;background:transparent;border-radius:3px}
+
+.readylist{align-self:stretch;margin-top:16px;padding:13px 16px;background:#F1F8F5;
+  border:1px solid #CFE3DE;border-radius:14px}
+.readylist>summary{display:flex;align-items:center;gap:11px;cursor:pointer;list-style:none}
+.readylist>summary::-webkit-details-marker{display:none}
+.readylist__tick{width:30px;height:30px;flex:none;border-radius:50%;background:var(--teal);color:#fff;
+  display:flex;align-items:center;justify-content:center}
+.readylist>summary b{font-family:var(--display);font-size:17px;color:var(--ink);display:block}
+.readylist__note{font-size:var(--text-description);color:var(--muted)}
+.readylist .table-scroll{margin-top:11px}
+.dtable--ready td{vertical-align:middle}
+
+.deepdive{align-self:stretch;margin-top:16px;border-top:1px solid var(--line-soft);padding-top:13px}
+.deepdive>summary{cursor:pointer;list-style:none;font-size:var(--text-secondary);font-weight:700;
+  color:var(--ink-2);display:flex;align-items:center;gap:9px}
+.deepdive>summary::-webkit-details-marker{display:none}
+.deepdive>summary::before{content:"";width:0;height:0;flex:none;
+  border:4px solid transparent;border-left-color:var(--muted);transition:transform .15s ease}
+.deepdive[open]>summary::before{transform:rotate(90deg) translateX(-1px)}
+
+@media (max-width:900px){
+  .summary{grid-template-columns:1fr}
+  .attention__head{flex-wrap:wrap}
+  .attention__sort{margin-left:0;width:100%}
+  .attention__sort select{width:100%}
+}
+
+/* ===== stock-age bands (US2.3) =====
+   Colours are fixed by AC8: #167D74 current, #D99120 getting old,
+   #9B3939 too old. Each band is named in words too, so the colour is
+   never the only signal. */
+.bands{align-self:stretch;margin-top:14px}
+.bands__bar{display:flex;gap:2px;height:14px;border-radius:7px;overflow:hidden;background:var(--line-soft)}
+.bands__seg{min-width:4px}
+.bands__legend{list-style:none;margin:11px 0 0;padding:0;display:grid;
+  grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:7px 18px}
+.bands__legend li{display:grid;grid-template-columns:10px auto minmax(0,1fr) auto;align-items:center;
+  gap:7px;font-size:var(--text-description)}
+.bands__swatch{width:10px;height:10px;border-radius:3px}
+.bands__name{font-weight:700;color:var(--ink-2)}
+.bands__note{color:var(--muted)}
+.bands__count{font-family:var(--data);color:var(--ink-2)}
+
+/* AC2 — count date, age and label on one line */
+.freshness-card__line{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
+.freshness-card__line i{font-style:normal;color:var(--line)}
+.freshness-card__line strong{font-weight:700;color:var(--ink)}
+
+/* what Used and Left out mean, said in the open rather than on hover */
+.use-key{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin:12px 0 0;
+  font-size:var(--text-description);color:var(--muted)}
+
+/* the scope statement now leads the screen instead of closing it */
+.validity--top{align-self:stretch;margin-top:14px}
+.footer-row--actions{justify-content:flex-end}
+
+
+/* ===== tidy-ups =====
+   Evidence, not work — one line each, folded away until asked for. */
+.tidyups{margin-top:16px;border-top:1px solid var(--line-soft);padding-top:12px}
+.tidyups>summary{display:flex;align-items:center;gap:9px;cursor:pointer;list-style:none;
+  font-size:var(--text-secondary);font-weight:700;color:var(--ink-2)}
+.tidyups>summary::-webkit-details-marker{display:none}
+.tidyups>summary::before{content:"";width:0;height:0;flex:none;
+  border:4px solid transparent;border-left-color:var(--muted);transition:transform .15s ease}
+.tidyups[open]>summary::before{transform:rotate(90deg) translateX(-1px)}
+.tidyups__list{list-style:none;margin:11px 0 0;padding:0;display:grid;gap:7px}
+.tidyups__list li{display:flex;align-items:center;gap:8px;flex-wrap:wrap;
+  font-size:var(--text-description);color:var(--muted)}
+.tidyups__list b{font-family:var(--data);color:var(--ink-2)}
+.tidyups__where{font-weight:600;color:var(--ink-2)}
+.tidyups__what{color:var(--muted)}
+
+
+/* ===== charts =====================================================
+   Thin marks, hairline recessive axes, 4px rounded data-ends anchored to
+   the baseline, a 2px surface gap between touching fills. Text never wears
+   the data colour — the mark beside it carries identity. */
+
+/* sub-cause bars inside an issue card */
+.minibars{position:relative;display:flex;align-items:flex-end;gap:8px;width:100%;margin-top:10px;
+  padding-top:2px;pointer-events:none}
+.minibars__col{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;gap:3px}
+.minibars__value{font-family:var(--data);font-size:var(--text-label);color:var(--muted);line-height:1}
+.minibars__track{width:100%;max-width:24px;height:30px;display:flex;align-items:flex-end}
+.minibars__fill{width:100%;border-radius:4px 4px 0 0;min-height:2px}
+.minibars__label{font-size:var(--text-label);line-height:1.2;color:var(--muted);text-align:center;
+  overflow-wrap:anywhere}
+
+/* weekly sales columns */
+.chart__plot{display:flex;align-items:flex-end;gap:2px;height:140px;padding-top:18px;
+  border-bottom:1px solid var(--line)}
+.chart__col{position:relative;flex:1;min-width:0;max-width:24px;height:100%;
+  display:flex;align-items:flex-end;justify-content:center}
+.chart__bar{width:100%;background:var(--teal);border-radius:4px 4px 0 0}
+.chart__cap{position:absolute;top:-16px;left:50%;transform:translateX(-50%);
+  font-family:var(--data);font-size:var(--text-label);color:var(--muted);white-space:nowrap}
+.chart__axis{display:flex;justify-content:space-between;margin-top:6px;
+  font-size:var(--text-label);color:var(--muted);font-family:var(--data)}
+
+.chart-row{align-self:stretch;display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);
+  gap:10px;margin-top:13px}
+.chart-card{margin-top:0}
+.chart-card__body{display:grid;grid-template-columns:minmax(0,1fr) 150px;gap:18px;align-items:end}
+
+.statgrid{display:grid;gap:10px;margin:0}
+.statgrid div{display:flex;flex-direction:column;gap:1px}
+.statgrid dt{font-size:var(--text-label);color:var(--muted);text-transform:uppercase;letter-spacing:.5px}
+.statgrid dd{margin:0;font-family:var(--display);font-size:19px;font-weight:800;color:var(--ink);line-height:1.1}
+
+/* part-to-whole; every exact count lives in the legend, not on the arc */
+.donut{display:flex;align-items:center;gap:20px;flex-wrap:wrap;margin-top:14px}
+.donut__ring{position:relative;flex:none}
+.donut__centre{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;
+  justify-content:center;gap:1px;pointer-events:none}
+.donut__centre b{font-family:var(--display);font-size:22px;font-weight:800;color:var(--ink);line-height:1}
+.donut__centre span{font-size:var(--text-label);color:var(--muted)}
+.donut__legend{flex:1;min-width:190px;list-style:none;margin:0;padding:0;display:grid;gap:6px}
+.donut__legend li{display:grid;grid-template-columns:10px minmax(0,1fr) auto 38px;align-items:center;
+  gap:8px;font-size:var(--text-description)}
+.donut__swatch{width:10px;height:10px;border-radius:3px}
+.donut__name{color:var(--ink-2);overflow-wrap:anywhere}
+.donut__count,.donut__share{font-family:var(--data);color:var(--muted);text-align:right}
+
+/* one column per week; a missing week is a gap, never a zero-height bar */
+.weekchart{display:flex;align-items:flex-end;gap:3px;height:52px;margin-top:10px;
+  padding-bottom:5px;border-bottom:1px solid var(--line)}
+.weekchart__col{position:relative;flex:1;min-width:6px;max-width:22px;height:100%;
+  display:flex;align-items:flex-end}
+.weekchart__mark{width:100%;border-radius:4px 4px 0 0}
+.weekchart__col--observed_demand .weekchart__mark{background:var(--teal)}
+/* recorded a real zero: a solid baseline tick, so it is not mistaken for a gap */
+.weekchart__col--confirmed_zero_sales .weekchart__mark{height:3px;background:var(--teal-deep);border-radius:2px}
+/* activity that nets to zero: outlined, distinct from both zero and missing */
+.weekchart__col--net_zero_with_activity .weekchart__mark{height:9px;border:1.5px solid var(--teal);
+  background:#fff;border-radius:3px}
+/* no data at all: hatched, never a bar — "no data" is not "no sales" */
+.weekchart__col--missing .weekchart__mark{height:9px;border-radius:3px;
+  border:1px dashed #6E7B80;
+  background:repeating-linear-gradient(45deg,#C6D6D1 0 3px,#FFFFFF 3px 6px)}
+
+.weekchart-key{display:flex;flex-wrap:wrap;gap:12px;margin-top:9px;
+  font-size:var(--text-label);color:var(--muted)}
+.weekchart-key span{display:inline-flex;align-items:center;gap:5px}
+.weekchart-key i{width:12px;height:9px;border-radius:3px;display:inline-block}
+
+@media (max-width:1100px){
+  .chart-row{grid-template-columns:1fr}
+  .chart-card__body{grid-template-columns:1fr;align-items:stretch}
+  .statgrid{grid-template-columns:repeat(2,minmax(0,1fr))}
+}
+@media (max-width:760px){
+  .minibars{gap:5px}
+  .minibars__label{display:none}
+}
+
+/* ===== readiness result (US2.1 AC1) =====
+   Can continue / Must fix / Next step, so the outcome is legible before the
+   table. The three cells read left to right as: what works, what does not,
+   what to do about it. */
+.verdict{align-self:stretch;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:11px}
+.verdict__cell{display:flex;flex-direction:column;gap:2px;padding:15px 17px;border-radius:14px;
+  border:1px solid var(--line);background:#fff}
+.verdict__cell--go{background:var(--teal-tint);border-color:#CFE3DE}
+.verdict__cell--fix{background:#FDF3F2;border-color:#F0D6D2}
+.verdict__label{font-size:var(--text-eyebrow);font-weight:800;text-transform:uppercase;
+  letter-spacing:.6px;color:var(--muted)}
+.verdict__value{font-family:var(--display);font-size:27px;font-weight:800;color:var(--ink);line-height:1.1}
+.verdict__note,.verdict__next{font-size:var(--text-description);line-height:1.5;color:var(--muted);margin:0}
+.verdict__next{margin-top:5px}
+.verdict__cell--next .btn{margin-top:10px;align-self:flex-start}
+
+/* ===== find one product without reading the table (US2.1 AC2) ===== */
+.issue-search{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:14px}
+.issue-search__field{display:flex;align-items:center;gap:8px;flex:1 1 240px;min-width:0;
+  padding:8px 12px;border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--muted)}
+.issue-search__field:focus-within{border-color:var(--teal);box-shadow:0 0 0 3px rgba(22,125,116,.12)}
+.issue-search__field input{flex:1;min-width:0;border:0;outline:0;background:none;
+  font-family:var(--body);font-size:var(--text-body);color:var(--ink)}
+.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;
+  clip:rect(0 0 0 0);white-space:nowrap;border:0}
+
+@media (max-width:900px){ .verdict{grid-template-columns:1fr} }
+
+/* ===== field help =====
+   The attribute descriptions used to sit under every label, which made the
+   mapping table a wall of prose. They are tooltips now: the table scans, and
+   the explanation is one hover or tap away. aria-label carries the same text,
+   so it reaches screen readers whether or not the bubble is shown. */
+.field-head{display:flex;align-items:center;gap:7px;flex-wrap:wrap}
+/* The bubble is a SIBLING of the button, not its child: a <button> will not
+   size an absolutely positioned descendant from its content, so the text
+   spilled out of the dark box. The wrapper is the positioning context. */
+.hint{position:relative;display:inline-flex;flex:none}
+.hint__btn{width:18px;height:18px;padding:0;border:0;border-radius:50%;
+  background:#E7EFEC;color:#5C7A72;font-family:var(--body);font-size:var(--text-label);font-weight:800;
+  line-height:1;cursor:help;display:inline-flex;align-items:center;justify-content:center}
+.hint__btn:hover,.hint__btn:focus-visible{background:var(--teal-tint);color:var(--teal-deep)}
+.hint__bubble{position:absolute;left:-10px;bottom:calc(100% + 9px);
+  width:260px;max-width:min(260px,calc(100vw - 48px));padding:10px 12px;border-radius:10px;background:var(--ink);color:#F3FAF8;
+  font-size:var(--text-description);font-weight:400;line-height:1.45;text-align:left;
+  opacity:0;visibility:hidden;transition:opacity .13s ease;z-index:5;pointer-events:none;
+  box-shadow:0 8px 24px rgba(22,49,59,.22)}
+.hint__bubble::after{content:"";position:absolute;top:100%;left:19px;
+  border:6px solid transparent;border-top-color:var(--ink)}
+.hint:hover .hint__bubble,.hint__btn:focus-visible ~ .hint__bubble{opacity:1;visibility:visible}
+/* near the top of the table there is no room above, so it flips below */
+.dtable tbody tr:first-child .hint__bubble{bottom:auto;top:calc(100% + 9px)}
+.dtable tbody tr:first-child .hint__bubble::after{top:auto;bottom:100%;border-top-color:transparent;border-bottom-color:var(--ink)}
+/* flipped when a left-anchored bubble would run off the right edge */
+.hint__bubble--end{left:auto;right:-10px}
+.hint__bubble--end::after{left:auto;right:19px}
+@media (max-width:760px){ .hint__bubble{width:210px} }
+
+/* ===== the workflow grows =====
+   🌱 → 🌿 → 🍃 → 🌳 across the four steps. Steps not yet reached are drained
+   of colour, so the row reads as progress at a glance. Purely decorative —
+   aria-hidden, and the dot still carries the number or the tick. */
+.stepper{height:auto;min-height:96px;padding-top:12px;padding-bottom:12px}
+.step__plant{font-size:16px;line-height:1;filter:grayscale(1);opacity:.35;
+  transition:filter .2s ease,opacity .2s ease}
+.step--done .step__plant,.step--current .step__plant{filter:none;opacity:1}
+.step--current .step__plant{transform:scale(1.15)}
+.step__line{top:35px}
+@media(prefers-reduced-motion:reduce){.step__plant{transition:none}}
+@media(max-width:760px){ .step__plant{font-size:14px} }
+
+/* ===== identity choice =====
+   The card is the button. Previously a 14px button sat inside a large card,
+   so the obvious target did nothing. */
+.identity__path{display:flex;flex-direction:column;align-items:flex-start;gap:5px;width:100%;
+  font-family:var(--body);text-align:left;cursor:pointer;
+  transition:border-color .15s ease,background-color .15s ease,box-shadow .15s ease}
+.identity__path:hover:not(:disabled){border-color:var(--mint);background:#F4FAF8}
+.identity__path:focus-visible{outline:2px solid var(--teal);outline-offset:2px}
+.identity__path:disabled{cursor:not-allowed;opacity:.62}
+.identity__path--on{box-shadow:0 0 0 3px rgba(22,125,116,.12)}
+.identity__path-fields{margin:0}
+.identity__path-state{margin-top:5px;font-size:var(--text-secondary);font-weight:700;color:var(--teal)}
+.identity__path--on .identity__path-state{color:var(--teal-deep)}
+.identity__path:disabled .identity__path-state{color:var(--muted);font-weight:600}
+
+/* ===== what more data would unlock =====
+   A light teal box inside the sage panel. Grouped by the missing column
+   rather than by capability, so it is three short rows instead of seven
+   repeating paragraphs. */
+.unlocks{margin-top:24px;padding:15px 16px;background:var(--teal-tint);
+  border:1px solid #B9DBD5;border-radius:14px}
+.unlocks__title{margin:0;font-family:var(--display);font-size:var(--text-body);
+  font-weight:700;color:var(--teal-deep)}
+.unlocks__lede{margin:4px 0 0;font-size:var(--text-description);color:var(--muted)}
+.unlocks__list{list-style:none;margin:11px 0 0;padding:0}
+.unlocks__list li{margin-bottom:9px;font-size:var(--text-description);line-height:1.45}
+.unlocks__list li:last-child{margin-bottom:0}
+.unlocks__list b{display:block;font-size:var(--text-secondary);color:var(--ink)}
+.unlocks__list span{color:var(--muted)}
