+/** A preview that reads at a glance.
+ *  A stock-count column repeats one date on every row, so printing it five
+ *  times says nothing — distinct values only, and ISO dates in the form a
+ *  person writes them. */
+function formatPreview(values: readonly string[]): string {
+  const seen: string[] = [];
+  for (const raw of values) {
+    const value = String(raw ?? "").trim();
+    if (!value || seen.includes(value)) continue;
+    seen.push(value);
+    if (seen.length === 3) break;
+  }
+  if (seen.length === 0) return "—";
+  const pretty = seen.map((value) => {
+    const iso = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);
+    if (!iso) return value;
+    return `${Number(iso[3])} ${MONTHS[Number(iso[2]) - 1]} ${iso[1]}`;
+  });
+  return pretty.join(" · ");
+}
